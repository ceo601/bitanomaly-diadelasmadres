rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'email', 'createdAt']) &&
        data.keys().hasOnly(['id', 'displayName', 'email', 'photoURL', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 && data.id == request.auth.uid &&
        data.email is string && data.email.size() <= 256 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50));
    }

    function isValidReel(data) {
      return data.keys().hasAll(['id', 'userId', 'momName', 'humorQuote', 'emotionalQuote', 'frameStyle', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'authorName', 'momName', 'humorQuote', 'emotionalQuote', 'frameStyle', 'cartoonPose', 'photoUrl', 'likesCount', 'createdAt', 'isPublic']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid &&
        data.momName is string && data.momName.size() <= 100 &&
        data.humorQuote is string && data.humorQuote.size() <= 300 &&
        data.emotionalQuote is string && data.emotionalQuote.size() <= 400 &&
        data.frameStyle is string && data.frameStyle.size() <= 50 &&
        (!('authorName' in data) || (data.authorName is string && data.authorName.size() <= 100)) &&
        (!('cartoonPose' in data) || (data.cartoonPose is string && data.cartoonPose.size() <= 50)) &&
        (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 2000000)) &&
        (!('likesCount' in data) || (data.likesCount is number && data.likesCount >= 0)) &&
        (!('isPublic' in data) || (data.isPublic is bool)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50));
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data);
      allow delete: if false;
    }

    match /reels/{reelId} {
      allow get: if isValidId(reelId) && (resource.data.isPublic == true || (isSignedIn() && resource.data.userId == request.auth.uid));
      allow list: if isSignedIn();
      allow create: if isValidId(reelId) && isSignedIn() && isValidReel(request.resource.data);
      allow update: if isValidId(reelId) && isSignedIn() && (
        (isOwner(resource.data.userId) && isValidReel(request.resource.data)) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount']) && request.resource.data.likesCount is number)
      );
      allow delete: if isValidId(reelId) && isOwner(resource.data.userId);
    }
  }
}
